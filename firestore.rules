rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'thisiszaki18@gmail.com';
    }

    function validDocumentation(data) {
      return data.keys().hasAll([
          'title', 'description', 'opinion', 'imageUrl', 'imagePath',
          'published', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'description', 'opinion', 'imageUrl', 'imagePath',
          'published', 'createdAt', 'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.description is string
        && data.description.size() <= 3000
        && data.opinion is string
        && data.opinion.size() <= 2000
        && data.imageUrl is string
        && data.imagePath is string
        && data.imagePath.matches('documentation/.+')
        && data.published == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validProfile(data) {
      return data.keys().hasAll(['name', 'imageUrl', 'imagePath', 'updatedAt'])
        && data.keys().hasOnly(['name', 'imageUrl', 'imagePath', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.imageUrl is string
        && data.imagePath is string
        && (data.imagePath == '' || data.imagePath.matches('profile/.+'))
        && data.updatedAt is timestamp;
    }

    match /documentation/{documentId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update: if isAdmin() && validDocumentation(request.resource.data);
      allow delete: if isAdmin();
    }

    match /siteContent/profile {
      allow read: if true;
      allow create, update: if isAdmin() && validProfile(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}